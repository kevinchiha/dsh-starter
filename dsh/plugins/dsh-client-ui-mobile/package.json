{
  "name": "dsh-client-ui-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local phone layout for the dsh web GUI. CSS only, no dependencies, no host behaviour.",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "client": { "platform": "web" },
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
